        MessageHandler(
            filters.Regex(r"^(👥 زیرمجموعه‌گیری|👥 Referrals)$"),
            referrals,
        )
    )

    app.add_handler(
        MessageHandler(
            filters.Regex(r"^(📦 سفارش‌های من|📦 My Orders)$"),
